{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-5d52d3.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://web-production-5d52d3.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
